---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { TaxonomyItem } from '../../lib/emdash';
import { getPosts, getPostBySlug } from '../../lib/emdash';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt}>
  <article>
    <header style="margin-bottom: 2.5rem;">
      <small style="color: var(--color-text-muted);">
        Published on {new Date(post.publishedAt).toLocaleDateString('en-US', { dateStyle: 'long' })}
        {post.author && ` • By ${post.author.name}`}
      </small>
      
      <h1 style="margin-top: 0.5rem;">{post.title}</h1>

      {post.featuredImage && (
        <img 
          src={post.featuredImage.url} 
          alt={post.featuredImage.altText || post.title} 
        />
      )}
    </header>

    <div set:html={post.content} />

    {post.tags && post.tags.length > 0 && (
      <footer style="margin-top: 3rem;">
        <hr />
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
          {post.tags.map((tag: TaxonomyItem) => (
            <span style="color: var(--color-primary); font-size: var(--fs-sm);">#{tag.slug}</span>
          ))}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>